<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo do botão de navegação. A tela aberta ganha superfície e contorno; as outras ficam planas. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#14342A" />
            <stroke android:width="1dp" android:color="#2F6B55" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#1B2734" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#0E151D" />
            <stroke android:width="1dp" android:color="#1C2733" />
        </shape>
    </item>
</selector>
