<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#090D12">
    <FrameLayout android:id="@+id/preview_container" android:layout_width="0dp" android:layout_height="0dp" android:layout_margin="12dp"
        app:layout_constraintDimensionRatio="16:9" app:layout_constraintEnd_toStartOf="@id/control_panel"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent">
        <androidx.camera.view.PreviewView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="match_parent" />
        <dev.cascam.ui.ComposedOutputView android:id="@+id/composed_output" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
        <SurfaceView android:id="@+id/gpu_output" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
        <FrameLayout android:id="@+id/scoreboard_preview_container" android:layout_width="240dp" android:layout_height="135dp"
            android:layout_gravity="top|end" android:layout_margin="18dp" android:background="#000000" android:visibility="gone">
            <androidx.camera.view.PreviewView android:id="@+id/scoreboard_preview" android:layout_width="match_parent" android:layout_height="match_parent" />
        </FrameLayout>
        <dev.cascam.ui.CompositionOverlayView android:id="@+id/composition_overlay" android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>

    <LinearLayout android:id="@+id/control_panel" android:layout_width="340dp" android:layout_height="0dp" android:orientation="vertical" android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/nav_broadcast" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="AO VIVO" />
                <Button android:id="@+id/nav_video" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="VÍDEO" />
                <Button android:id="@+id/nav_court" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="QUADRA" />
                <Button android:id="@+id/nav_scoreboard" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="PLACAR" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/nav_clock" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="CRONO" />
                <Button android:id="@+id/nav_logo" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="ÍCONE" />
                <Button android:id="@+id/nav_diagnostics" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="TESTE" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:id="@+id/panel_broadcast" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView style="@style/PanelTitle" android:text="Composição e transmissão" />
                    <TextView style="@style/PanelLabel" android:text="Protocolo de ingestão" />
                    <Spinner android:id="@+id/broadcast_protocol" android:layout_width="match_parent" android:layout_height="48dp" />
                    <TextView style="@style/PanelLabel" android:text="Composição" />
                    <Spinner android:id="@+id/composition_engine" android:layout_width="match_parent" android:layout_height="48dp" />
                    <TextView android:id="@+id/composition_hint" style="@style/PanelHint" android:text="CPU converte cada quadro e desenha em Canvas. GPU deixa a câmera escrever em textura e compõe em OpenGL, sem passar pelo processador." />
                    <TextView style="@style/PanelLabel" android:text="Rotação da imagem" />
                    <Spinner android:id="@+id/frame_rotation" android:layout_width="match_parent" android:layout_height="48dp" />
                    <TextView style="@style/PanelHint" android:text="Vale só para a composição em GPU, que recebe o quadro pela SurfaceTexture e pode chegar já girado. Em CPU o giro é sempre automático." />
                    <TextView style="@style/PanelLabel" android:text="Resolução da câmera da quadra" />
                    <Spinner android:id="@+id/capture_resolution" android:layout_width="match_parent" android:layout_height="48dp" />
                    <TextView style="@style/PanelLabel" android:text="FPS da câmera da quadra" />
                    <Spinner android:id="@+id/capture_fps" android:layout_width="match_parent" android:layout_height="48dp" />
                    <TextView style="@style/PanelHint" android:text="Cada lista mostra os valores anunciados pela câmera escolhida. Se duas camadas compartilham a câmera, vale o perfil mais exigente. O driver ainda pode recusar combinações simultâneas pesadas." />
                    <TextView style="@style/PanelText" android:text="Confira o enquadramento verde e a área amarela do placar antes de entrar ao vivo." />
                    <TextView style="@style/PanelLabel" android:text="Servidor do YouTube" />
                    <EditText android:id="@+id/youtube_server" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" android:textColor="#FFFFFF" android:singleLine="true" />
                    <TextView style="@style/PanelLabel" android:text="Chave da transmissão" />
                    <EditText android:id="@+id/youtube_key" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="xxxx-xxxx-xxxx-xxxx" android:inputType="textPassword" android:textColor="#FFFFFF" android:textColorHint="#718191" android:singleLine="true" />
                    <TextView style="@style/PanelLabel" android:text="OAuth Client ID do Google Cloud" />
                    <EditText android:id="@+id/youtube_client_id" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="…apps.googleusercontent.com" android:inputType="text" android:textColor="#FFFFFF" android:textColorHint="#718191" android:singleLine="true" />
                    <TextView style="@style/PanelLabel" android:text="OAuth Client Secret (cliente para TV)" />
                    <EditText android:id="@+id/youtube_client_secret" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:textColor="#FFFFFF" android:singleLine="true" />
                    <TextView style="@style/PanelLabel" android:text="Título da nova live" />
                    <EditText android:id="@+id/live_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:textColor="#FFFFFF" android:singleLine="true" />
                    <TextView style="@style/PanelLabel" android:text="Privacidade" />
                    <Spinner android:id="@+id/live_privacy" android:layout_width="match_parent" android:layout_height="48dp" />
                    <TextView style="@style/PanelHint" android:text="Não listada abre só por link direto e não aparece na página do canal. Escolha Público para a live ser vista por quem entra no seu canal." />
                    <TextView style="@style/PanelLabel" android:text="Latência" />
                    <Spinner android:id="@+id/live_latency" android:layout_width="match_parent" android:layout_height="48dp" />
                    <TextView android:id="@+id/latency_hint" style="@style/PanelHint" android:text="HLS é segmentado e não alcança a ultrabaixa; para o menor atraso use RTMPS." />
                    <Button android:id="@+id/authorize_youtube" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1. AUTORIZAR YOUTUBE" />
                    <LinearLayout android:id="@+id/oauth_code_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                        android:background="#121A24" android:padding="10dp" android:layout_marginTop="8dp" android:visibility="gone">
                        <TextView style="@style/PanelLabel" android:layout_marginTop="0dp" android:text="Código do dispositivo (copiado para a área de transferência)" />
                        <TextView android:id="@+id/oauth_code" style="@style/OauthCode" android:text="—" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <Button android:id="@+id/copy_oauth_code" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="COPIAR CÓDIGO" />
                            <Button android:id="@+id/open_oauth_page" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="ABRIR PÁGINA" />
                        </LinearLayout>
                    </LinearLayout>
                    <Button android:id="@+id/create_live" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="2. CRIAR LIVE E TRANSMITIR" />
                    <TextView android:id="@+id/oauth_status" style="@style/PanelHint" android:text="OAuth ainda não configurado." />
                    <LinearLayout android:id="@+id/live_link_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
                        android:background="#121A24" android:padding="10dp" android:layout_marginTop="8dp" android:visibility="gone">
                        <TextView style="@style/PanelLabel" android:layout_marginTop="0dp" android:text="Endereço desta live" />
                        <TextView android:id="@+id/live_link" style="@style/PanelText" android:textIsSelectable="true" android:textColor="#73E2A7" android:text="—" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <Button android:id="@+id/open_live" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="ABRIR" />
                            <Button android:id="@+id/check_live" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="VER STATUS" />
                        </LinearLayout>
                        <TextView android:id="@+id/live_health" style="@style/PanelHint" android:text="Toque em Ver status para saber por que ela ainda não apareceu." />
                    </LinearLayout>
                    <Button android:id="@+id/save_button" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Salvar" />
                    <Button android:id="@+id/start_button" android:layout_width="match_parent" android:layout_height="64dp" android:text="▶ INICIAR TRANSMISSÃO" />
                    <TextView android:id="@+id/broadcast_status" style="@style/PanelHint" android:text="Pronto para transmitir em RTMPS." />
                </LinearLayout>

                <LinearLayout android:id="@+id/panel_video" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView style="@style/PanelTitle" android:text="Qualidade de saída" />
                    <TextView style="@style/PanelText" android:text="Estas opções controlam o vídeo codificado e enviado. São independentes da resolução e do FPS usados para capturar cada câmera." />
                    <TextView style="@style/PanelLabel" android:text="Resolução enviada" />
                    <Spinner android:id="@+id/output_resolution" android:layout_width="match_parent" android:layout_height="52dp" />
                    <TextView style="@style/PanelLabel" android:text="FPS enviado" />
                    <Spinner android:id="@+id/output_fps" android:layout_width="match_parent" android:layout_height="52dp" />
                    <TextView style="@style/PanelHint" android:text="O FPS é o limite do encoder. Para entregar todos os quadros, as câmeras também precisam capturar nesse FPS." />
                    <TextView style="@style/PanelLabel" android:text="Codec de vídeo" />
                    <Spinner android:id="@+id/video_codec" android:layout_width="match_parent" android:layout_height="52dp" />
                    <TextView style="@style/PanelLabel" android:text="Uso de dados / bitrate" />
                    <Spinner android:id="@+id/bitrate_preset" android:layout_width="match_parent" android:layout_height="52dp" />
                    <TextView android:id="@+id/output_quality_hint" style="@style/PanelHint" android:text="720p30 · automático: 3 Mbps" />
                    <Button android:id="@+id/save_video" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:text="SALVAR QUALIDADE" />
                </LinearLayout>

                <LinearLayout android:id="@+id/panel_court" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView style="@style/PanelTitle" android:text="Configurar quadra" />
                    <TextView style="@style/PanelText" android:text="Verde: recorte 16:9 da quadra. Azul: destino do placar. Roxo: destino do cronômetro. Escolha abaixo qual destino será arrastado. A linha central indica o nível." />
                    <TextView style="@style/PanelLabel" android:text="Câmera da quadra" />
                    <Spinner android:id="@+id/court_camera" android:layout_width="match_parent" android:layout_height="48dp" />
                    <TextView style="@style/PanelLabel" android:text="Zoom real da câmera da quadra" />
                    <SeekBar android:id="@+id/court_capture_zoom" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="70" />
                    <TextView android:id="@+id/court_capture_zoom_status" style="@style/PanelHint" android:text="Captura: 1,0× · aplicado antes da saída 1080p." />
                    <TextView style="@style/PanelLabel" android:text="Sobreposição que será posicionada" />
                    <Spinner android:id="@+id/court_overlay" android:layout_width="match_parent" android:layout_height="48dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <Button android:id="@+id/crop_larger" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="− MAIS ÁREA" />
                        <Button android:id="@+id/crop_smaller" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="+ MENOS ÁREA" />
                    </LinearLayout>
                    <TextView android:id="@+id/court_crop_status" style="@style/PanelHint" android:text="Zoom do recorte: 1.0×" />
                </LinearLayout>

                <LinearLayout android:id="@+id/panel_scoreboard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView style="@style/PanelTitle" android:text="Configurar placar" />
                    <CheckBox android:id="@+id/scoreboard_enabled" android:layout_width="match_parent" android:layout_height="48dp" android:text="Sobrepor placar" android:textColor="#FFFFFF" />
                    <TextView style="@style/PanelText" android:text="Amarelo: ajuste os quatro cantos do placar inclinado; ele será planificado. A posição na composição fica na aba QUADRA, dentro do retângulo verde." />
                    <TextView style="@style/PanelLabel" android:text="Câmera do placar" />
                    <Spinner android:id="@+id/scoreboard_camera" android:layout_width="match_parent" android:layout_height="48dp" />
                    <TextView style="@style/PanelLabel" android:text="Resolução desta fonte" />
                    <Spinner android:id="@+id/scoreboard_capture_resolution" android:layout_width="match_parent" android:layout_height="48dp" />
                    <TextView style="@style/PanelLabel" android:text="FPS desta fonte" />
                    <Spinner android:id="@+id/scoreboard_capture_fps" android:layout_width="match_parent" android:layout_height="48dp" />
                    <TextView style="@style/PanelLabel" android:text="Zoom real da câmera do placar" />
                    <SeekBar android:id="@+id/scoreboard_capture_zoom" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="70" />
                    <TextView android:id="@+id/scoreboard_capture_zoom_status" style="@style/PanelHint" android:text="Captura: 1,0× · aplicado antes da saída 1080p." />
                    <TextView style="@style/PanelLabel" android:text="Ampliar a tela para ajustar os cantos" />
                    <SeekBar android:id="@+id/scoreboard_view_zoom" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="50" />
                    <TextView android:id="@+id/scoreboard_view_zoom_status" style="@style/PanelHint" android:text="Tela: 1.0× · só amplia a visualização, não muda o que é transmitido." />
                </LinearLayout>

                <LinearLayout android:id="@+id/panel_clock" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView style="@style/PanelTitle" android:text="Configurar cronômetro" />
                    <CheckBox android:id="@+id/clock_enabled" android:layout_width="match_parent" android:layout_height="48dp" android:text="Sobrepor cronômetro" android:textColor="#FFFFFF" />
                    <TextView style="@style/PanelText" android:text="Ajuste os quatro cantos do cronômetro filmado. Ele pode reutilizar a câmera da quadra ou do placar." />
                    <TextView style="@style/PanelLabel" android:text="Câmera do cronômetro" />
                    <Spinner android:id="@+id/clock_camera" android:layout_width="match_parent" android:layout_height="48dp" />
                    <TextView style="@style/PanelLabel" android:text="Resolução desta fonte" />
                    <Spinner android:id="@+id/clock_capture_resolution" android:layout_width="match_parent" android:layout_height="48dp" />
                    <TextView style="@style/PanelLabel" android:text="FPS desta fonte" />
                    <Spinner android:id="@+id/clock_capture_fps" android:layout_width="match_parent" android:layout_height="48dp" />
                    <TextView style="@style/PanelLabel" android:text="Zoom real da câmera do cronômetro" />
                    <SeekBar android:id="@+id/clock_capture_zoom" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="70" />
                    <TextView android:id="@+id/clock_capture_zoom_status" style="@style/PanelHint" android:text="Captura: 1,0× · aplicado antes da saída 1080p." />
                    <TextView style="@style/PanelLabel" android:text="Ampliar a tela para ajustar os cantos" />
                    <SeekBar android:id="@+id/clock_view_zoom" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="50" />
                    <TextView android:id="@+id/clock_view_zoom_status" style="@style/PanelHint" android:text="Tela: 1.0× · só amplia a visualização, não muda o que é transmitido." />
                </LinearLayout>

                <LinearLayout android:id="@+id/panel_logo" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView style="@style/PanelTitle" android:text="Ícone da transmissão" />
                    <CheckBox android:id="@+id/logo_enabled" android:layout_width="match_parent" android:layout_height="52dp" android:text="Mostrar ícone sobre o vídeo" android:textColor="#FFFFFF" />
                    <CheckBox android:id="@+id/logo_white_transparent" android:layout_width="match_parent" android:layout_height="52dp" android:text="Transformar branco em transparente" android:textColor="#FFFFFF" />
                    <TextView style="@style/PanelHint" android:text="Também suaviza os tons quase brancos da borda para evitar recorte serrilhado." />
                    <TextView style="@style/PanelText" android:text="Escolha uma imagem, preferencialmente PNG com fundo transparente. Ela será incorporada à prévia e ao vídeo enviado." />
                    <ImageView android:id="@+id/logo_preview" android:layout_width="match_parent" android:layout_height="96dp" android:layout_marginTop="8dp" android:background="#121A24" android:contentDescription="Prévia do ícone" android:scaleType="centerInside" />
                    <TextView android:id="@+id/logo_file_status" style="@style/PanelHint" android:text="Nenhuma imagem selecionada." />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <Button android:id="@+id/select_logo" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="ESCOLHER PNG" />
                        <Button android:id="@+id/remove_logo" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="REMOVER" />
                    </LinearLayout>
                    <TextView style="@style/PanelLabel" android:text="Tamanho" />
                    <SeekBar android:id="@+id/logo_size" android:layout_width="match_parent" android:layout_height="wrap_content" android:min="5" android:max="50" />
                    <TextView android:id="@+id/logo_size_status" style="@style/PanelHint" android:text="Largura: 18% do vídeo" />
                    <TextView style="@style/PanelLabel" android:text="Posição horizontal" />
                    <SeekBar android:id="@+id/logo_position_x" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" />
                    <TextView style="@style/PanelLabel" android:text="Posição vertical" />
                    <SeekBar android:id="@+id/logo_position_y" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" />
                    <TextView android:id="@+id/logo_position_status" style="@style/PanelHint" android:text="Posição: 88% horizontal · 85% vertical" />
                    <Button android:id="@+id/save_logo" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:text="SALVAR ÍCONE" />
                </LinearLayout>

                <LinearLayout android:id="@+id/panel_diagnostics" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView style="@style/PanelTitle" android:text="Teste de duas câmeras" />
                    <TextView style="@style/PanelText" android:text="Liga de verdade cada par possível, confere se os dois fluxos são diferentes e desce a resolução até achar a maior aceita. Nos pares físicos, mantém a lente aberta da quadra sem zoom e tenta o zoom máximo somente na lente fechada de placar/cronômetro. Apoie o celular, aponte para uma cena iluminada com detalhes e deixe a tela ligada." />
                    <Button android:id="@+id/run_probe" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:text="▶ TESTAR PARES DE CÂMERA" />
                    <TextView android:id="@+id/probe_status" style="@style/PanelHint" android:text="Nenhum teste executado ainda." />
                    <Button android:id="@+id/copy_probe_report" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="COPIAR RELATÓRIO" android:enabled="false" />
                    <TextView android:id="@+id/probe_report" style="@style/ProbeReport" android:text="O relatório aparece aqui." />
                    <TextView style="@style/PanelTitle" android:layout_marginTop="18dp" android:text="Teste conclusivo GPU + foto" />
                    <TextView style="@style/PanelText" android:text="Usa as câmeras escolhidas nas abas QUADRA e PLACAR. Mantém a quadra em uma SurfaceTexture OpenGL real e tira três fotos do placar, uma por segundo. Só aprova se a foto vier cheia e o vídeo não parar." />
                    <Button android:id="@+id/run_photo_probe" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp" android:text="▶ TESTAR GPU + FOTO" />
                    <TextView android:id="@+id/photo_probe_status" style="@style/PanelHint" android:text="Selecione dois sensores físicos e execute o teste." />
                    <Button android:id="@+id/copy_photo_probe_report" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="COPIAR RELATÓRIO GPU + FOTO" android:enabled="false" />
                    <TextView android:id="@+id/photo_probe_report" style="@style/ProbeReport" android:text="O relatório específico aparece aqui." />
                </LinearLayout>
            </FrameLayout>
        </ScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
