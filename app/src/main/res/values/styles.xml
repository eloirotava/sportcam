<resources>
    <style name="Theme.SportCam" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#73E2A7</item>
        <item name="android:navigationBarColor">#090D12</item>
        <item name="android:statusBarColor">#090D12</item>
    </style>
    <!--
      Aba da navegação: ícone em cima, rótulo curto embaixo. Ícone puro seria ambíguo entre "Vídeo"
      e "Ao vivo", e a configuração é feita no ginásio, muitas vezes com pressa.
    -->
    <style name="NavTab" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">62dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:background">@drawable/nav_background</item>
        <item name="android:textColor">@color/nav_tint</item>
        <item name="android:drawableTint">@color/nav_tint</item>
        <item name="android:drawablePadding">3dp</item>
        <item name="android:textSize">9sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="PanelTitle" parent="android:style/Widget.TextView">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#73E2A7</item><item name="android:textStyle">bold</item><item name="android:textSize">19sp</item>
    </style>
    <style name="PanelText" parent="android:style/Widget.TextView">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item><item name="android:textColor">#D6DEE8</item>
    </style>
    <style name="PanelLabel" parent="PanelText">
        <item name="android:layout_marginTop">14dp</item><item name="android:textStyle">bold</item>
    </style>
    <style name="OauthCode" parent="android:style/Widget.TextView">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item><item name="android:gravity">center</item>
        <item name="android:textColor">#73E2A7</item><item name="android:textStyle">bold</item><item name="android:textSize">30sp</item>
        <item name="android:fontFamily">monospace</item><item name="android:letterSpacing">0.18</item>
        <item name="android:textIsSelectable">true</item>
    </style>
    <style name="ProbeReport" parent="android:style/Widget.TextView">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item><item name="android:background">#121A24</item><item name="android:padding">8dp</item>
        <item name="android:textColor">#D6DEE8</item><item name="android:textSize">11sp</item>
        <item name="android:fontFamily">monospace</item><item name="android:textIsSelectable">true</item>
    </style>
    <style name="PanelHint" parent="PanelText">
        <item name="android:layout_marginTop">6dp</item><item name="android:textColor">#9EADBC</item><item name="android:textSize">12sp</item>
    </style>
</resources>
